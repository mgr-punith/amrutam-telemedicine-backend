NODE_ENV=development
PORT=3000
METRICS_PORT=9100
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3001

DATABASE_URL=postgresql://amrutam:amrutam@postgres:5432/amrutam
REDIS_URL=redis://redis:6379
AMRUTAM_SERVICE_NAME=amrutam-api
AMRUTAM_OTEL_EXPORTER_ENDPOINT=
AMRUTAM_WORKER_SCAN_INTERVAL_MS=60000

# Run `npm run security:generate-keys` and copy its output into your untracked `.env`.
AMRUTAM_ENCRYPTION_KEYS={"v1":"replace-with-32-byte-base64-key"}
AMRUTAM_ACTIVE_ENCRYPTION_KEY_VERSION=v1
AMRUTAM_JWT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-pem
AMRUTAM_JWT_PUBLIC_KEY_BASE64=replace-with-base64-spki-pem
AMRUTAM_JWT_KEY_ID=local-v1
AMRUTAM_JWT_ISSUER=amrutam-api
AMRUTAM_JWT_AUDIENCE=amrutam-clients
AMRUTAM_ACCESS_TOKEN_TTL_SECONDS=900
AMRUTAM_REFRESH_TOKEN_TTL_SECONDS=2592000
AMRUTAM_TOTP_ISSUER=Amrutam
AMRUTAM_PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
AMRUTAM_DEMO_PASSWORD=replace-with-at-least-12-random-characters
AMRUTAM_DEMO_MFA_SECRET=replace-with-base32-secret

